services:
  db:
    image: postgis/postgis:17-3.5
    container_name: reach-db
    environment:
      POSTGRES_DB: reach
      POSTGRES_USER: ${POSTGRES_USER:?Administrator username required}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?Administrator password required}
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U "$$POSTGRES_USER" -d reach
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  pgdata:
